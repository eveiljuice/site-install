#!/usr/bin/env bash
# site-install — интерактивный установщик сайтов
# Расположение: /usr/local/bin/site-install (после установки)
# Исходники: /usr/local/share/site-install/

set -euo pipefail

# Подключаем библиотеки и адаптеры
SITE_INSTALL_LIB="${SITE_INSTALL_LIB:-/usr/local/share/site-install/lib}"
SITE_INSTALL_ADAPTERS="${SITE_INSTALL_ADAPTERS:-/usr/local/share/site-install/adapters}"

# Если скрипт запущен из репо (для разработки) — ищем lib рядом
if [[ -d "$(dirname "$(readlink -f "$0")")/../lib" ]]; then
  REPO_ROOT="$(dirname "$(readlink -f "$0")")/.."
  SITE_INSTALL_LIB="$REPO_ROOT/lib"
  SITE_INSTALL_ADAPTERS="$REPO_ROOT/adapters"
fi

# Загружаем core
if [[ ! -f "$SITE_INSTALL_LIB/core.sh" ]]; then
  echo "site-install: не найден core.sh в $SITE_INSTALL_LIB"
  echo ""
  echo "Похоже, установка прошла некорректно (пустые каталоги lib/ и adapters/)."
  echo "Переустановите:"
  echo "  curl -fsSL https://raw.githubusercontent.com/eveiljuice/site-install/main/bootstrap/install.sh | sudo bash"
  exit 1
fi
source "$SITE_INSTALL_LIB/core.sh"

# Загружаем адаптеры
for adapter in "$SITE_INSTALL_ADAPTERS"/*.sh; do
  [[ -f "$adapter" ]] || continue
  [[ "$(basename "$adapter")" == "_contract.sh" ]] && continue
  source "$adapter"
done

# Маршрутизация аргументов
case "${1:-}" in
  --dry-run)   shift; main_dry_run "$@" ;;
  --list)      main_list ;;
  --version|-v) main_version ;;
  --help|-h)   main_help ;;
  "")          main_interactive ;;
  *)           echo "Unknown argument: $1"; main_help; exit 1 ;;
esac
